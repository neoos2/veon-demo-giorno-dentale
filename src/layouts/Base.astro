---
import literataCyrillic from "../assets/fonts/literata-cyrillic.woff2?url";

interface Props { lang: string; title: string; description: string; canonical?: string; }
const { lang, title, description, canonical } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-rec="SE-R007">{title}</title>
    <meta name="description" content={description} data-rec="SE-R007" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="uk_UA" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={literataCyrillic} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <style is:global>
      @import "../styles/tokens.css";
      @import "../styles/fonts.css";
      @import "../styles/global.css";
      @import "../styles/site.css";
    </style>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
