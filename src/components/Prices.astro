---
import FutureLink from "./FutureLink.astro";
import Price from "./Price.astro";
const implants = [
  { name: "Bauers", price: "5 500" },
  { name: "Neodent", price: "7 500" },
  { name: "MegaGen", price: "10 500" },
  { name: "Straumann", price: "22 100", old: "26 000" },
];
const care = [
  { name: "Консультація стоматолога-терапевта", now: "0", old: "300", free: true },
  { name: "Ультразвукова чистка з поліруванням, 2 щелепи", now: "650", old: "1 300" },
  { name: "Комплексна гігієна", now: "1 870", old: "2 200" },
  { name: "Пломба", now: "1 200–2 200" },
];
const restore = [
  { name: "Коронка цирконієва", now: "12 150", old: "13 500" },
  { name: "Коронка металокерамічна", now: "9 520", old: "11 200" },
  { name: "Брекети металеві, 1\u00a0щелепа", now: "14 700", old: "21 000" },
  { name: "Брекети керамічні, 1\u00a0щелепа", now: "21 700", old: "31 000" },
  { name: "Елайнер CristaLine", now: "3 800", unit: "грн за шт." },
  { name: "Елайнер Easy Align", now: "3 300", unit: "грн за шт." },
];
---
<section id="prices" class="section prices" aria-labelledby="prices-title">
  <div class="container">
    <div class="section__head">
      <h2 id="prices-title">Скільки коштує</h2>
      <p class="section__lead">Імплантація від бюджетної системи до преміальної, ціна з роботою лікаря.</p>
    </div>
    <p class="implants__title">Імплант і робота</p>
    <ul class="implants">
      {implants.map((i) => (
        <li class="implant">
          <h3>{i.name}</h3>
          {i.old && <span class="implant__old"><s>{i.old} грн</s></span>}
          <span><span class="implant__price num">{i.price}</span> <span class="implant__unit">грн</span></span>
          {i.old && <span class="implant__tag">за акцією</span>}
        </li>
      ))}
    </ul>
    <div class="plist__grid">
      <div class="plist">
        <h3>Огляд і гігієна</h3>
        <ul>{care.map((r) => <li class="plist__row"><span class="plist__name">{r.name}</span><Price now={r.now} old={r.old} free={r.free} /></li>)}</ul>
      </div>
      <div class="plist">
        <h3>Коронки й вирівнювання</h3>
        <ul>{restore.map((r) => <li class="plist__row"><span class="plist__name">{r.name}</span><Price now={r.now} old={r.old} unit={r.unit} /></li>)}</ul>
      </div>
    </div>
    <div class="prices__foot">
      <p class="small muted">Ціни з прайсу на сайті клініки; закреслено — ціна без акції. Лікування можна розстрочити.</p>
      <div class="prices__links">
        <FutureLink note="Розділ у розробці">Усі ціни</FutureLink>
        <FutureLink note="Розділ у розробці">Акції</FutureLink>
        <FutureLink note="Розділ у розробці">Гарантія</FutureLink>
        <button class="btn" type="button" popovertarget="sheet-call">Записатися на консультацію</button>
      </div>
    </div>
  </div>
</section>
