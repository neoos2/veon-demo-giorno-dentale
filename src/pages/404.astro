---
import Base from "../layouts/Base.astro";
---
<Base lang="uk" title="Сторінку не знайдено — Giorno Dentale" description="Такої сторінки немає. Поверніться на головну Giorno Dentale.">
  <section class="section">
    <div class="container nf">
      <h1>Такої сторінки немає</h1>
      <p class="section__lead">Можливо, адресу змінено. На головній — клініки в Києві, Львові й Кракові, ціни й контакти.</p>
      <a class="btn btn--primary" href={import.meta.env.BASE_URL}>На головну</a>
    </div>
  </section>
</Base>
