---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Directions from "../components/Directions.astro";
import Prices from "../components/Prices.astro";
import Doctors from "../components/Doctors.astro";
import Network from "../components/Network.astro";
import Abroad from "../components/Abroad.astro";
import Clinics from "../components/Clinics.astro";
import Footer from "../components/Footer.astro";
import Sheets from "../components/Sheets.astro";
import BottomBar from "../components/BottomBar.astro";
import { buildSchema } from "../data/schema";

const title = "Стоматологія в Києві, Львові та Кракові — Giorno Dentale";
const description = "11 стоматологій Giorno Dentale: 6 у Києві, 3 у Львові, 2 у Кракові. Перша консультація безкоштовно, імпланти від 5 500 грн, розстрочка";
const schema = JSON.stringify(buildSchema());
---
<Base lang="uk" title={title} description={description}>
  <script slot="head" type="application/ld+json" data-rec="SE-R003" set:html={schema} />
  <Header slot="header" />
  <Hero />
  <Directions />
  <Prices />
  <Doctors />
  <Network />
  <Abroad />
  <Clinics />
  <Footer slot="footer" />
  <Sheets />
  <BottomBar />
</Base>
<script src="../scripts/live.ts"></script>
